---
import { site } from '../../config/site';
import { highlights } from '../../data/skills';
import { projects } from '../../data/projects';
import Icon from '../Icon.astro';
import Avatar from '../Avatar.astro';

// Counted from the project data, so they stay true as projects are added.
const onPlay = projects.filter((p) => p.links.some((l) => l.kind === 'google-play')).length;
const liveWeb = projects.filter((p) => p.categories.includes('web') && p.links.some((l) => l.kind === 'website')).length;
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-copy">
      <h2 id="about-title" class="section-title" data-reveal>Building software that makes a difference.</h2>
      <div class="about-text" data-reveal style="--i: 1">
        <p>
          I’m a developer who enjoys solving problems through software. My work spans frontend interfaces, backend architecture, mobile applications,
          AI-powered products, and integrations that connect systems together.
        </p>
        <p>
          I focus on building solutions that are not only technically sound but also intuitive, maintainable, and useful to the people who rely on them.
        </p>
      </div>
      <dl class="about-facts" data-reveal style="--i: 2">
        <div>
          <dt>Android apps live on Google Play</dt>
          <dd>{onPlay}</dd>
        </div>
        <div>
          <dt>Web products live in this portfolio</dt>
          <dd>{liveWeb}</dd>
        </div>
      </dl>
    </div>

    <div class="about-side">
      <div class="profile" data-reveal>
        <Avatar size={112} decorative />
        <div>
          <p class="profile-name">{site.name}</p>
          <p class="profile-role">{site.headline}</p>
          <div class="profile-links">
            {
              site.social.linkedin && (
                <a class="text-link" href={site.social.linkedin} target="_blank" rel="me noopener noreferrer">
                  LinkedIn
                  <Icon name="arrow-up-right" size={16} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )
            }
            {
              site.social.github && (
                <a class="text-link" href={site.social.github} target="_blank" rel="me noopener noreferrer">
                  <Icon name="github" size={16} />
                  GitHub
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )
            }
            {
              site.email && (
                <a class="text-link" href={`mailto:${site.email}`}>
                  <Icon name="mail" size={16} />
                  {site.email}
                </a>
              )
            }
          </div>
        </div>
      </div>
      <ul class="highlights" role="list">
        {
          highlights.map((h, i) => (
            <li data-reveal style={`--i: ${i}`}>
              <span class="hl-icon">
                <Icon name="check" size={18} />
              </span>
              <div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--surface);
  }

  .about-grid {
    display: grid;
    gap: clamp(48px, 6vw, 96px);
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .about-copy .section-title {
    max-width: 14ch;
  }

  .about-text {
    display: grid;
    gap: 18px;
    max-width: 38rem;
    margin-top: clamp(24px, 3vw, 40px);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .about-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: clamp(32px, 4vw, 56px) 0 0;
  }

  .about-facts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .about-facts dd {
    margin: 0;
    color: var(--accent);
    font-size: clamp(3rem, 2.4rem + 2.6vw, 4.5rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .about-facts dt {
    max-width: 16ch;
    margin-top: 8px;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 24px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .profile :global(.avatar) {
    border-radius: 28px;
  }

  .profile-name {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .profile-role {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    font-size: var(--fs-small);
  }

  @media (max-width: 480px) {
    .profile {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .highlights {
    display: grid;
    gap: 12px;
    list-style: none;
  }

  .highlights li {
    display: flex;
    gap: 16px;
    padding: 22px 24px;
    border-radius: var(--radius);
    background: var(--bg);
  }

  .hl-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
  }

  .highlights h3 {
    text-wrap: wrap;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .highlights p {
    margin-top: 4px;
    color: var(--muted);
    font-size: var(--fs-small);
  }
</style>
