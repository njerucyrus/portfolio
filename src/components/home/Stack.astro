---
import * as icons from 'simple-icons';
import { skillGroups } from '../../data/skills';

type SimpleIcon = { path: string; title: string };
const iconFor = (name?: string) => (name ? ((icons as unknown as Record<string, SimpleIcon>)[name] ?? null) : null);
---

<section id="stack" class="section stack" aria-labelledby="stack-title">
  <div class="container">
    <header class="section-head section-head--split">
      <h2 id="stack-title" class="section-title" data-reveal>Technical stack</h2>
      <p class="section-intro" data-reveal style="--i: 1">The tools I work with, grouped by where they sit in a product.</p>
    </header>

    <div class="stack-list">
      {
        skillGroups.map((group) => (
          <section class="stack-row" aria-labelledby={`stack-${group.id}`} data-reveal>
            <div class="stack-label">
              <h3 id={`stack-${group.id}`}>{group.title}</h3>
              <p>{group.summary}</p>
            </div>
            <ul class="stack-skills" role="list">
              {group.skills.map((skill) => {
                const icon = iconFor(skill.icon);
                return (
                  <li class="skill">
                    {icon ? (
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                        <path d={icon.path} />
                      </svg>
                    ) : (
                      <span class="skill-dot" aria-hidden="true" />
                    )}
                    {skill.label}
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="stack-note">Logos from Simple Icons. Trademarks belong to their owners.</p>
  </div>
</section>

<style>
  .stack-list {
    display: grid;
  }

  .stack-row {
    display: grid;
    gap: 16px 48px;
    padding-block: clamp(22px, 2.6vw, 32px);
    border-top: 1px solid var(--border);
  }

  .stack-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 860px) {
    .stack-row {
      grid-template-columns: minmax(220px, 1fr) 2fr;
      align-items: center;
    }
  }

  .stack-label h3 {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .stack-label p {
    margin-top: 4px;
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .stack-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .skill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    transition:
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .skill:hover {
    box-shadow: inset 0 0 0 1px var(--border-strong);
    transform: translateY(-1px);
  }

  .skill svg {
    flex: none;
    fill: var(--ink-2);
  }

  .skill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .stack-note {
    margin-top: 20px;
    color: var(--muted);
    font-size: var(--fs-xs);
  }
</style>
