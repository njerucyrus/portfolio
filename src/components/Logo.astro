---
// The TripleFive254 T5 mark. Two versions are rendered and the header shows the
// one that suits its current background: `logo-on-light` (navy-to-blue T) on light,
// `logo-on-dark` (brighter blues) on dark. The files live in public/brand/ and
// are copies of brand/triplefive254-mark*.svg cropped to the mark's edges.
import { url } from '../lib/url';

interface Props {
  /** Height in px; the width follows the mark's 4:3 shape. */
  size?: number;
}
const { size = 34 } = Astro.props;
const width = Math.round(size * 1.3321);
---

<span class="logo" aria-hidden="true">
  <img class="logo-on-light" src={url('brand/t5-mark.svg')} width={width} height={size} alt="" decoding="async" />
  <img class="logo-on-dark" src={url('brand/t5-mark-reversed.svg')} width={width} height={size} alt="" decoding="async" />
</span>

<style>
  .logo {
    display: inline-flex;
    flex: none;
  }

  .logo img {
    display: block;
  }
</style>
