---
// The TripleFive254 Ventures mark: a T and a 5 sharing one top stroke, on an
// indigo tile. Keep in step with `mark` in scripts/build-brand.mjs.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="#635BFF"></rect>
  <path d="M7.5 9.5h17M11.5 9.5v13" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M24.5 9.5h-7.2l-.7 5a4.6 4.6 0 1 1-.4 6.6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
