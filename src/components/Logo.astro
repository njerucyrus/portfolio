---
// The site mark: a C and an N drawn as one stroke on an indigo tile.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="#635BFF"></rect>
  <path d="M14.5 10.4a6 6 0 1 0 0 11.2" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"></path>
  <path d="M17.6 21.6V10.4l7 11.2V10.4" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
