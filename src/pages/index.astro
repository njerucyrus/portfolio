---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import Expertise from '../components/home/Expertise.astro';
import Stack from '../components/home/Stack.astro';
import About from '../components/home/About.astro';
import Process from '../components/home/Process.astro';
import Contact from '../components/home/Contact.astro';
import { site } from '../config/site';
---

<BaseLayout headerTheme="dark" home>
  <Hero />

  <section id="work" class="section work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head section-head--split">
        <h2 id="work-title" class="section-title" data-reveal>Selected Work</h2>
        <p class="section-intro" data-reveal style="--i: 1">
          The track record {site.name} is built on: digital products and applications our founder, {site.founder.name}, has built across web, mobile, AI,
          and automation.
        </p>
      </header>
      <ProjectGallery />
    </div>
  </section>

  <Expertise />
  <Stack />
  <About />
  <Process />
  <Contact />
</BaseLayout>

<style>
  .work {
    padding-top: clamp(72px, 8vw, 128px);
  }
</style>
