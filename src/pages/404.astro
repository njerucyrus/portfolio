---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
import { url, section } from '../lib/url';

const suggestions = projects.slice(0, 4);
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <section class="container not-found" aria-labelledby="nf-title">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1 id="nf-title">This page doesn’t exist.</h1>
    <p class="nf-text">The link may be out of date, or the address may have a typo. Here are a few ways back in.</p>
    <div class="nf-actions">
      <a class="btn btn-primary" href={url()}>
        Go to the home page
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn-secondary" href={url('projects/')}>Browse all projects</a>
    </div>

    <h2 class="nf-subtitle">Popular projects</h2>
    <ul class="nf-list" role="list">
      {
        suggestions.map((p) => (
          <li>
            <a href={url(`projects/${p.slug}/`)}>
              <span>{p.name}</span>
              <span class="nf-kind">{p.kind}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="nf-contact">
      Looking for something specific? <a href={section('contact')}>Send me a message</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(56px, 9vw, 128px);
  }

  .nf-code {
    color: var(--accent);
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  h1 {
    margin-top: 24px;
    font-size: var(--fs-h2);
    letter-spacing: -0.045em;
  }

  .nf-text {
    max-width: 34rem;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: var(--fs-lead);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .nf-subtitle {
    margin-top: clamp(56px, 7vw, 96px);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .nf-list {
    display: grid;
    gap: 10px;
    max-width: 40rem;
    margin-top: 16px;
    list-style: none;
  }

  .nf-list a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    font-weight: 600;
    text-decoration: none;
  }

  .nf-list a:hover {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .nf-kind {
    color: var(--muted);
    font-weight: 400;
    font-size: var(--fs-small);
    text-align: right;
  }

  .nf-contact {
    margin-top: 32px;
    color: var(--ink-2);
  }
</style>
