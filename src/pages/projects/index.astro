---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { section } from '../../lib/url';
---

<BaseLayout
  title="Projects"
  description={`All ${projects.length} projects by Cyrus Njeru: web applications, Android apps, AI and voice agents, and automation.`}
>
  <section class="section projects-page" aria-labelledby="projects-title">
    <div class="container">
      <header class="section-head section-head--split">
        <h1 id="projects-title" class="section-title">All projects</h1>
        <p class="section-intro">
          Web platforms, Android apps, AI and voice agents, and the integrations between them. Each one opens into a case study with real screenshots.
        </p>
      </header>
      <ProjectGallery headingLevel="h2" />
      <p class="projects-cta">
        <a class="text-link" href={section('contact')}>
          Have something in mind? Let’s talk
          <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding-top: clamp(48px, 6vw, 96px);
  }

  .projects-cta {
    margin-top: 48px;
  }
</style>
